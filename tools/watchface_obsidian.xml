<?xml version="1.0" encoding="utf-8"?>
<WatchFace clipShape="CIRCLE" width="1000" height="1000">
    <Metadata key="CLOCK_TYPE" value="ANALOG"/>
    <Scene backgroundColor="#ff000000">
        <!-- Active Mode -->
        <Group name="active_obsidian" x="0" y="0" width="1000" height="1000">
            <Variant mode="AMBIENT" target="alpha" value="0"/>

            <!-- 1. Brushed Metal Dial with Subdials & Hour Markers (ZERO BRANDING) -->
            <PartImage x="0" y="0" width="1000" height="1000">
                <Image resource="obsidian_dial"/>
            </PartImage>

            <!-- 2. Power Reserve Needle at 9 o'clock (Center at 215, 475) -->
            <PartImage x="207" y="375" width="16" height="125" pivotX="0.5" pivotY="0.80">
                <Transform target="rotation" value="([BATTERY_PERCENT] - 50) * 1.2"/>
                <Image resource="obsidian_power_hand"/>
            </PartImage>

            <!-- 3. Independent Small Seconds at 6 o'clock (Center at 500, 715) -->
            <AnalogClock x="492" y="595" width="16" height="160">
                <SecondHand resource="obsidian_small_sec" x="0" y="0" width="16" height="160" pivotX="0.5" pivotY="0.75"/>
            </AnalogClock>

            <!-- 4. Center 3D Faceted Dauphine Hands (Hour & Minute - NO center seconds) -->
            <AnalogClock x="0" y="0" width="1000" height="1000">
                <HourHand resource="obsidian_hour" x="476" y="214" width="48" height="320" pivotX="0.5" pivotY="0.893"/>
                <MinuteHand resource="obsidian_minute" x="480" y="95" width="40" height="440" pivotX="0.5" pivotY="0.920"/>
            </AnalogClock>

            <!-- 5. Central Multi-Layered Platinum Hub Cap -->
            <PartImage x="470" y="470" width="60" height="60">
                <Image resource="obsidian_hub"/>
            </PartImage>
        </Group>

        <!-- Ambient (AOD) Mode -->
        <Group name="ambient" x="0" y="0" width="1000" height="1000" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255"/>

            <!-- AMOLED Black Dial with Applied Platinum Markers & Subdial Outlines -->
            <PartImage x="0" y="0" width="1000" height="1000">
                <Image resource="obsidian_dial_aod"/>
            </PartImage>

            <!-- AOD Center Dauphine Hands (Hour & Minute with Platinum Luminous Contour) -->
            <AnalogClock x="0" y="0" width="1000" height="1000">
                <HourHand resource="obsidian_hour_aod" x="476" y="214" width="48" height="320" pivotX="0.5" pivotY="0.893"/>
                <MinuteHand resource="obsidian_minute_aod" x="480" y="95" width="40" height="440" pivotX="0.5" pivotY="0.920"/>
            </AnalogClock>

            <!-- Central Hub Cap -->
            <PartImage x="470" y="470" width="60" height="60">
                <Image resource="obsidian_hub"/>
            </PartImage>
        </Group>
    </Scene>
</WatchFace>
